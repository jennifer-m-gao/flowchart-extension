{
  "name": "pychart-extension",
  "displayName": "PyChart",
  "description": "Visualizes Python code as flowcharts in VS Code",
  "repository": { "type": "git", "url": "https://github.com/jennifer-m-gao/flowchart-extension" },
  "version": "1.1.0",
  "publisher": "JenniferGao",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pychart-extension.openFlowchart",
        "title": "PyChart: Open Visualizer"
      }
    ]
  },
  "scripts": {
    "build:webview": "esbuild webview/main.js --bundle --minify --format=iife --outfile=dist/webview/bundle.js",
    "vscode:prepublish": "npm run build:webview",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"webview/cfg/**\" --test-coverage-include=\"webview/run/**\" --test-coverage-lines=90 \"test/unit/*.test.mjs\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "bench": "node scripts/bench.mjs",
    "test:ui": "npm run build:webview && node test/ui/run.mjs",
    "pretest": "npm run test:coverage && npm run build:webview && npm run check:bundle && npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@lezer/python": "^1.1.19",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "elkjs": "0.12.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "globals": "^15.0.0",
    "puppeteer-core": "25.16.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
